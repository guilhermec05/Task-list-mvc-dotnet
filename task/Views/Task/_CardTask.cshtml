@model task.ViewModels.TaskListViewModel
@using task.Resources
@using task.Models.enums

@{ 
    Dictionary<StateTask,string> map = new Dictionary<StateTask, string>();


    map.Add(StateTask.InProgress, "text-bg-primary");
    map.Add(StateTask.Cancelled, "text-bg-secondary");
    map.Add(StateTask.Finished, "text-bg-success");
    map.Add(StateTask.Pending, "text-bg-warning");
}



<div class="card" style="width: 30rem;">
    <div class="card-header d-flex justify-content-between" >
        <span class="badge  @map[Model.State]">@Model.State</span>
        @if (Model.IsExpired)
        {
            <i class="fas fa-hourglass-end"></i>
        }


    </div>
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>
        <p class="card-text text-truncate">@Model.Description</p>
        <button class="btn btn-info btn-edit" edit-id="@Model.Id">@TaskMessages.Edit</button>
        <button class="btn btn-danger btn-delete" deleted-id="@Model.Id">@TaskMessages.Delete</button>
    </div> 
</div>