@using task.Resources



<div class="shadow-sm menu-task-app ">
    <nav class="nav justify-content-between p-4 container">
        <div class="logo">
            <i class="fa-solid fa-list-check"></i>
        </div>

        <div class="dropdown">
            <div class="user dropdown-toggle"
                 data-bs-toggle="dropdown"
                 aria-expanded="true"   >
                <i class="fa-solid fa-circle-user"></i>
                <span>
                    @User.Identity.Name
                </span>
            </div>
            <ul class="dropdown-menu">
                <li>
                    @Html.ActionLink(
                       TaskMessages.Perfil,
                       "",
                       "",
                       null,
                       new { @class = "dropdown-item" })

                </li>
                <li>
                    @Html.ActionLink(
                   TaskMessages.Logoff,
                    "Logout",
                    "Login",
                    null,
                    new { @class = "dropdown-item" })
                </li>
            </ul>

        </div>
       
    </nav>

</div>
