@using task.Resources



<div class="shadow-sm menu-task-app ">
    <nav class="nav justify-content-between p-4 container">
        <div class="logo">

            @Html.ActionLink(
            " ",
           "Index",
           "Task",
           null,
           new
           {
               @class = "fa-solid fa-list-check link-decoration-none"
           })
        </div>

        <div class="dropdown">
            <div class="user dropdown-toggle"
                 data-bs-toggle="dropdown"
                 aria-expanded="true"   >
                <i class="fa-solid fa-circle-user"></i>
                <span>
                    @User.Identity.Name
                </span>
            </div>
            <ul class="dropdown-menu">
                <li class="d-flex">
                    <div class="dropdown-item" >
                        <i class="fa-solid fa-user"></i>
                        @Html.ActionLink(
                           TaskMessages.Perfil,
                           "Index",
                           "User",
                           null,
                           new
                           {
                               @class = "link-decoration-none"
                           })
                    </div>
                  

                </li>
                <li>
                    <div class="dropdown-item">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        @Html.ActionLink(
                       TaskMessages.Logoff,
                        "Logout",
                        "Login",
                        null,
                        new
                        {
                            @class = "link-decoration-none"
                        })
                    </div>
                   
                </li>
            </ul>

        </div>
       
    </nav>

</div>
